# HTCondor submit file -- GW150914 bilby reference with SEOBNRv5HM (2,2), non-marginalised (= gwjax).
#   bash run_bilby_gw150914_v5hm.sh 1 --benchmark 20 --outdir bench     (head node, ~1 min: check first)
#   condor_submit run_bilby_gw150914_v5hm.sub
# Condor file transfer (execute nodes do not necessarily mount $HOME). The output dir comes back on
# exit and on eviction (ON_EXIT_OR_EVICT); an evicted job restarts from its 30-min checkpoint.
# Cost: ~47 ms per likelihood call (laptop, 1 core); ~2.5e7 calls -> ~300 CPU-h -> ~8-10 h on 32 cores.
universe                 = vanilla
executable               = run_bilby_gw150914_v5hm.sh
arguments                = 32
initialdir               = .
log                      = condor_gw150914_v5hm.log
output                   = condor_gw150914_v5hm.out
error                    = condor_gw150914_v5hm.err
request_cpus             = 32
request_memory           = 32GB
request_disk             = 8GB
should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT_OR_EVICT
transfer_input_files     = run_bilby_gw150914.py, data_lvk_welch
transfer_output_files    = bilby_gw150914_SEOBNRv5HM_lvk_welch
accounting_group         = ligo.dev.o4.cbc.pe.bilby
accounting_group_user    = saulo.soares-de-albuquerque-filho
queue
