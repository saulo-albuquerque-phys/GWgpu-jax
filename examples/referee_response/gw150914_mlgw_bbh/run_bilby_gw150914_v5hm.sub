# HTCondor submit file -- GW150914 bilby reference with SEOBNRv5HM (2,2), non-marginalised (= gwjax).
#   bash run_bilby_gw150914_v5hm.sh 1 --benchmark 20 --outdir bench     (head node, ~1 min: check first)
#   condor_submit run_bilby_gw150914_v5hm.sub
# Condor file transfer (execute nodes do not necessarily mount $HOME). The output dir comes back on
# exit and on eviction (ON_EXIT_OR_EVICT); an evicted job restarts from its 30-min checkpoint.
# Cost: ~47 ms per likelihood call (laptop, 1 core); ~2.5e7 calls -> ~300 CPU-h -> ~16-20 h on 16 cores (8-10 h on 32).
# SELF-CHECKPOINTING (Nov 2026): LDG evictions (code 1019) are not graceful, so the output dir was NOT
# transferred back and each eviction lost everything since the last graceful exit (GW150914 job:
# 158 h run, ~8 h kept). Now the job checkpoints and exits with code 77 every 7200 s
# (--periodic-restart-time); condor saves transfer_checkpoint_files and restarts it at once. A hard
# eviction therefore costs at most ~2 h. Tested locally: exit 77 + 'Resume file successfully loaded'.
universe                 = vanilla
executable               = run_bilby_gw150914_v5hm.sh
arguments                = 16 --periodic-restart-time 7200
initialdir               = .
log                      = condor_gw150914_v5hm.log
output                   = condor_gw150914_v5hm.out
error                    = condor_gw150914_v5hm.err
request_cpus             = 16
request_memory           = 16GB
request_disk             = 8GB
should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT_OR_EVICT
transfer_input_files     = run_bilby_gw150914.py, data_lvk_welch
transfer_output_files    = bilby_gw150914_SEOBNRv5HM_lvk_welch
checkpoint_exit_code     = 77
transfer_checkpoint_files = bilby_gw150914_SEOBNRv5HM_lvk_welch
accounting_group         = ligo.dev.o4.cbc.pe.bilby
accounting_group_user    = saulo.soares-de-albuquerque-filho
queue
