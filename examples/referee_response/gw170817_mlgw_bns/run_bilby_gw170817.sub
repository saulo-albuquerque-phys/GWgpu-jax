# HTCondor submit file -- GW170817 bilby + TEOBResumSPA reference run (LDG).
#   bash setup_ldg_env.sh          (once: puts teobresums in ./pylib)
#   condor_submit run_bilby_gw170817.sub
# Uses condor FILE TRANSFER: execute nodes do not necessarily mount $HOME (a shared-FS version of this
# file was held with "Failed to open ... condor_gw170817.out"). Inputs go to the node; the output
# directory comes back on exit AND on eviction (ON_EXIT_OR_EVICT): an evicted job restarts from its
# 30-min checkpoint by itself. To resume by hand after a crash/removal, append the returned output
# dir to transfer_input_files (it must exist, so not on the first submission) and resubmit. For variants change `arguments` AND transfer_output_files / transfer_input_files:
#   arguments = 32 --spin-prior high   -> output dir bilby_gw170817_TEOBResumSPA_gwtc1_highspin
#   arguments = 32 --psd-mode welch    -> needs data_welch in transfer_input_files; ..._welch_lowspin
#   arguments = 1 --benchmark 200      -> request_cpus = 1 (timing only, comment 6)
# Cost: ~70 ms per RB likelihood call (TEOB ODE dominates, single core). From the nlive-40 smoke run
# (H = 25 nats, 1194 its): ~3e4 iterations x ~500 calls = ~1.5e7 calls = ~300 CPU-h.
# Wall time: 32 cores ~10 h (default), 64 cores ~5-6 h, 128 cores ~3-4 h at lower efficiency
# (dynesty's parallel proposals stop scaling at ~5-10% of nlive).
universe                 = vanilla
executable               = run_bilby_gw170817.sh
arguments                = 32
initialdir               = .
log                      = condor_gw170817.log
output                   = condor_gw170817.out
error                    = condor_gw170817.err
request_cpus             = 32
request_memory           = 16GB
request_disk             = 8GB
should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT_OR_EVICT
transfer_input_files     = run_bilby_gw170817.py, teobresumspa_source.py, data_gwtc1, pylib
transfer_output_files    = bilby_gw170817_TEOBResumSPA_gwtc1_lowspin
accounting_group         = ligo.dev.o4.cbc.pe.bilby
accounting_group_user    = saulo.soares-de-albuquerque-filho
queue
